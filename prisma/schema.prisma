generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SessionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ParentRole {
  PARENT_A
  PARENT_B
}

enum AgeStage {
  BABY
  TODDLER
  CHILD
}

model User {
  id             String    @id @default(uuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  passwordHash   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  sessions       Session[]
}

model Session {
  id               String           @id @default(uuid())
  userId           String
  status           SessionStatus    @default(PENDING)
  relationshipType String?
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  user             User             @relation(fields: [userId], references: [id])
  parentPhotos     ParentPhoto[]
  generatedImages  GeneratedImage[]
}

model ParentPhoto {
  id        String      @id @default(uuid())
  sessionId String
  role      ParentRole
  fileUrl   String
  fileKey   String
  createdAt DateTime    @default(now())
  session   Session     @relation(fields: [sessionId], references: [id])
}

model GeneratedImage {
  id             String    @id @default(uuid())
  sessionId      String
  ageStage       AgeStage
  variationIndex Int
  fileUrl        String
  fileKey        String
  createdAt      DateTime  @default(now())
  session        Session   @relation(fields: [sessionId], references: [id])
}
